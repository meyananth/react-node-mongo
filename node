pipeline {
    agent any

    tools {
        nodejs 'node20'
    }

    stages {
        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'call npm install'
                    bat 'call npm run build'
                }
            }
        }

        stage('Check Backend') {
            steps {
                dir('backend') {
                    bat 'call npm install'
                }
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker --version'
                bat 'docker build -t react-node-frontend ./frontend'
                bat 'docker build -t react-node-backend ./backend'
            }
        }

        stage('Docker Deploy') {
            steps {
                bat 'docker compose down'
                bat 'docker compose up -d --build'
                bat 'docker compose ps'
            }
        }

        stage('Health Check') {
            steps {
                retry(10) {
                    bat 'ping -n 11 127.0.0.1 >nul'
                    bat 'curl -f http://localhost:3001'
                }
                retry(5) {
                    bat 'ping -n 6 127.0.0.1 >nul'
                    bat 'curl -f http://localhost:5000/health'
                }
            }
        }
    }

    post {
        failure {
            echo 'Deployment failed, check the stage logs'
            bat 'docker compose logs --tail 50'
        }
    }
}
