pipeline {
    agent any

    tools { nodejs 'node20' }

    environment {
        EC2_HOST = 'ec2-user@ec2-16-170-242-242.eu-north-1.compute.amazonaws.com'
        APP_URL  = 'http://ec2-16-170-242-242.eu-north-1.compute.amazonaws.com:3000'
    }

    stages {
        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'call npm ci'
                    bat 'call npm run build'
                }
            }
        }

        stage('Check Backend') {
            steps {
                dir('backend') {
                    bat 'call npm ci'
                }
            }
        }

        stage('Deploy to AWS') {
            steps {
                withCredentials([file(credentialsId: 'aws-key-file', variable: 'KEY')]) {
                    bat '''
                    icacls "%KEY%" /inheritance:r
                    icacls "%KEY%" /grant:r "%USERNAME%:R"
                    ssh -i "%KEY%" -o StrictHostKeyChecking=no %EC2_HOST% "cd react-node-mongo && git pull origin main && docker compose up -d --build && docker compose ps"
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                bat 'curl -f --retry 6 --retry-delay 5 --retry-connrefused %APP_URL%'
            }
        }
    }

    post {
        success { echo 'Deployment succeeded' }
        failure { echo 'Deployment failed, check the stage logs' }
    }
}
