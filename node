pipeline {
    agent any

    tools { nodejs 'node20' }

    stages {
        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'call npm install'
                    bat 'call npm run build'
                }
            }
        }

        stage('Check Backend') {
            steps {
                dir('backend') {
                    bat 'call npm install'
                }
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker --version'
                bat 'docker build -t react-node-frontend ./frontend'
                bat 'docker build -t react-node-backend ./backend'
            }
        }

        stage('Docker Deploy') {
            steps {
                bat 'docker compose down'
                bat 'docker compose up -d --build'
                bat 'docker compose ps'
            }
        }

 stage('Health Check') {
    steps {
        bat 'powershell -Command "for($i=0;$i -lt 12;$i++){try{Invoke-WebRequest http://localhost:3000 -UseBasicParsing | Out-Null; exit 0}catch{Start-Sleep 5}}; exit 1"'
        bat 'curl.exe -f http://localhost:5000'
    }
}

    post {
        success { echo 'Deployment succeeded' }
        failure {
            echo 'Deployment failed, check the stage logs'
            bat 'docker compose logs --tail 50'
        }
    }
}
