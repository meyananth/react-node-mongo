pipeline {
    agent any

    tools { nodejs 'node20' }

    environment {
        EC2_HOST = 'ubuntu@16.170.242.242'
    }

    stages {
        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'call npm install'
                    bat 'call npm run build'
                }
            }
        }

        stage('Check Backend') {
            steps {
                dir('backend') {
                    bat 'call npm install'
                }
            }
        }

                 stage('Deploy to AWS') {
            steps {
                withCredentials([file(credentialsId: 'aws-key-file', variable: 'KEY')]) {
                    bat '''
                    icacls "%KEY%" /inheritance:r
                    icacls "%KEY%" /grant:r "SYSTEM:R"
                    ssh -i "%KEY%" -o StrictHostKeyChecking=no %EC2_HOST% "cd react-node-mongo && git pull origin main && docker compose down && docker compose up -d --build && docker compose ps"
                    '''
                }
            }
        }
        stage('Health Check') {
            steps {
                bat 'ping -n 11 127.0.0.1 > nul'
                bat 'curl -f 16.170.242.242:3000'
            }
        }
    }

    post {
        success { echo 'Deployment succeeded' }
        failure { echo 'Deployment failed, check the stage logs' }
    }
}
