pipeline {
    agent any

    tools { nodejs 'node20' }

    stages {
        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'node -v'
                    bat 'call npm install'
                    bat 'call npm run build'
                    bat 'dir'
                }
            }
        }

        stage('Check Backend') {
            steps {
                dir('backend') {
                    bat 'call npm install'
                    bat 'dir'
                }
            }
        }
    }

    post {
        success { echo 'Build succeeded' }
        failure { echo 'Build failed, check the stage logs' }
    }
}
