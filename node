pipeline {
    agent any

    tools {
        nodejs 'node20'
    }

    stages {
        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    bat 'npm install'
                    bat 'npm run build'
                }
           }
        }
    }
stage('Check Backend') {
            steps {
                dir('backend') {
                    bat 'npm install'
                }
            }
        }

        stage('Docker Build') {
            steps {
                bat 'docker --version'
                bat 'docker build -t react-node-frontend ./frontend'
                bat 'docker build -t react-node-backend ./backend'
            }
        }
         
        stage('Docker Deploy') {
            steps {
                bat 'docker compose down --remove-orphans'
                bat 'docker compose up -d --build'
                bat 'docker compose ps'
            }
        }

        stage('Health Check') {
            steps {
                bat 'ping -n 16 127.0.0.1 > nul'
                bat 'curl -f http://localhost:3001'
            }
        }
}
    post {
        success {
            echo 'Deployment succeeded'
        }
        failure {
            echo 'Deployment failed, check the stage logs'
            bat 'docker compose logs --tail 50'
        }
    }
