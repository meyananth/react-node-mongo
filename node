pipeline {
    agent any

    tools { nodejs 'node20' }

    stages {
        stage('Debug') {
            steps {
                bat 'dir'
                bat 'dir /s /b package.json | findstr /v node_modules'
            }
        }

        stage('Build Frontend') {
            steps {
                dir('client') {
                    bat 'node -v'
                    bat 'call npm install'
                    bat 'call npm run build'
                }
            }
        }
    }

    post {
        success { echo 'Build succeeded' }
        failure { echo 'Build failed, check the stage logs' }
    }
}
